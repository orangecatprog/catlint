{
	"name": "catlint",
	"module": "src/index.ts",
	"type": "module",
	"scripts": {
		"lint": "eslint src --ext .ts",
		"format": "prettier --write src",
		"check": "bun run lint && bun run format",
		"test": "vitest",
		"prepare": "husky"
	},
	"engines": {
		"node": "^5.3.0"
	},
	"devDependencies": {
		"@eslint/css": "^1.0.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^1.2.0",
		"@eslint/markdown": "^8.0.0",
		"@types/bun": "latest",
		"@types/node": "^25.5.0",
		"@typescript-eslint/eslint-plugin": "^8.57.2",
		"@typescript-eslint/parser": "^8.57.2",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"prettier": "3.8.1",
		"typescript-eslint": "^8.57.2",
		"vitest": "^4.1.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"lint-staged": {
		"*.{ts,js}": [
			"eslint --fix",
			"prettier --write"
		]
	},
	"dependencies": {
		"catlint": ".",
		"chalk": "^5.6.2",
		"commander": "^14.0.3",
		"glob": "^13.0.6",
		"inquirer": "^13.3.2",
		"jiti": "^2.6.1",
		"minimatch": "^10.2.5"
	}
}
