{
	"name": "catlint",
	"version": "1.2.1",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"catlint": "./dist/cli/index.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup",
		"lint": "eslint src --ext .ts",
		"format": "prettier --write src",
		"test": "vitest"
	},
	"engines": {
		"node": ">=18"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"devDependencies": {
		"tsup": "^8.5.1"
	},
	"lint-staged": {
		"*.{ts,js}": [
			"eslint --fix",
			"prettier --write"
		]
	}
}
